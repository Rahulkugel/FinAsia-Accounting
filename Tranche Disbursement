-- aga.name as ledgername,
-- mpt.value as paymenttype,
-- concat('Loan disbursed for account : ',ml.display_loan_account_no ,' , Name: ',mc.display_name ) as descr
from m_loan_transaction mlt 
inner join (
select 
mlt.id as trxid,
mlt.loan_id as lid
from m_loan_transaction mlt 
where mlt.transaction_type_enum =1 and mlt.is_reversed =0
and mlt.id not in (select 
min(mlt.id ) as trxid
from m_loan_transaction mlt 
where mlt.transaction_type_enum =1 and mlt.is_reversed =0
group by mlt.loan_id )
and date(mlt.transaction_date) >="2026-04-01" and date(mlt.transaction_date ) <="2026-08-17" ) maxtrx  on maxtrx.lid= mlt.loan_id  and maxtrx.trxid=mlt.id 
left join m_loan ml on ml.id =mlt.loan_id
left join m_client mc on mc.id=ml.client_id 
left join m_payment_detail mpd on mpd.id =mlt.payment_detail_id 
left join m_payment_type mpt on mpt.id =mpd.payment_type_id 
left join acc_product_mapping apm on apm.product_id =ml.product_id 
left join acc_gl_account aga on aga.id =apm.gl_account_id 
where ml.loan_status_id !=500 and ml.loan_status_id >=300
and apm.financial_account_type =2
-- and mlt.loan_id =${loanid}
union all
