inner join (
select
gst.trxid as trxid,
gst.loanid,
sum(gst.gst)as gst
from
(
select 
mlt.id as trxid,
ml.id as loanid,
mcn.name,
mlt.transaction_date,
case
	when mlcpb.charge_tax is null or mlcpb.charge_tax =0
	then 0
	else (mlc.amount -round((mlc.amount*100) /118,2))/2 
end as gst,
case
	when mlcpb.charge_tax is null or mlcpb.charge_tax =0
	then 0
	else (mlc.amount -round((mlc.amount*100) /118,2))/2 
end as cgst
from m_loan_transaction mlt 
left join m_loan ml on ml.id =mlt.loan_id
left join m_client mc on mc.id =ml.client_id 
left join m_loan_charge_paid_by mlcpb on mlcpb.loan_transaction_id =mlt.id
left join m_loan_charge
mlc on mlc.id=mlcpb.loan_charge_id 
left join m_charge mcn on mcn.id =mlc.charge_id 
where date(mlt.transaction_date) >'2026-03-31' and mlt.is_reversed =0 and 
 ml.loan_status_id  >=300  and ml.loan_status_id !=500
and mlt.transaction_type_enum in (27) and date(mlt.transaction_date) <='2026-08-17'
)gst 
group by 
gst.trxid
having sum(gst.gst)>0 ) gst  on gst.loanid=ml.id 
inner  join m_loan_transaction mlt on mlt.id=gst.trxid
left join m_client mc on mc.id=ml.client_id
union all
